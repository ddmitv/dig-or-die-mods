<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    
    <PackageId>DigOrDie.DODModAPI.AssetPacker</PackageId>
    <AssemblyName>DODModAPI.AssetPacker</AssemblyName>
    <PackageVersion>0.1.0-re.$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmm'))</PackageVersion>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RootNamespace>DODModAPI.AssetPacker</RootNamespace>

    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.4.0" PrivateAssets="all" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/*" PackagePath="build/" Pack="true" />
    <None Include="$(OutputPath)SixLabors.ImageSharp.dll" PackagePath="$(BuildOutputTargetFolder)/$(TargetFramework)/" Pack="true" Visible="false" />
  </ItemGroup>
</Project>