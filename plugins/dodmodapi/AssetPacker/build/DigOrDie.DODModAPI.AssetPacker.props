<Project>
  <PropertyGroup>
    <_DODModAPIAssetPacker_TaskFolder Condition="'$(MSBuildRuntimeType)' == 'Core'">netstandard2.0</_DODModAPIAssetPacker_TaskFolder>
    <_DODModAPIAssetPacker_TaskFolder Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</_DODModAPIAssetPacker_TaskFolder>
    <_DODModAPIAssetPacker_TaskAssembly>$(MSBuildThisFileDirectory)..\tasks\$(_DODModAPIAssetPacker_TaskFolder)\DODModAPI.AssetPacker.dll</_DODModAPIAssetPacker_TaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="DODModAPI.AssetPacker.PackSpriteSheet"
             AssemblyFile="$(_DODModAPIAssetPacker_TaskAssembly)" />

  <Target Name="PackSprites" BeforeTargets="BeforeBuild;CoreCompile" Condition="'@(ModAtlas)' != ''">
    <PackSpriteSheet
      ConfigFiles="@(ModAtlas)"
      IntermediateOutputPath="$(BaseIntermediateOutputPath)"
      AtlasClass="%(ModAtlas.AtlasName)"
      ModId="$(MSBuildProjectName)">
      <Output TaskParameter="GeneratedCompile" ItemName="Compile" />
      <Output TaskParameter="GeneratedEmbeddedResource" ItemName="EmbeddedResource" />
    </PackSpriteSheet>
  </Target>

  <ItemDefinitionGroup>
    <ModAtlas Visible="true">
      <AtlasName />
    </ModAtlas>
  </ItemDefinitionGroup>

  <ItemGroup>
    <AvailableItemName Include="ModAtlas" />
  </ItemGroup>
</Project>
